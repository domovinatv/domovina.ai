{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domovina-katalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "observability": { "enabled": true },

  // Produkcija (S6, odobrio korisnik 6. 11. 2026., odluka 600+): ruta na zoni
  // domovina.ai, isti origin kao aplikacija; Pages (`web/_worker.js`) i dalje
  // servira sve ostalo. `account_id` se NE upisuje (CLOUDFLARE_ACCOUNT_ID u
  // .dev.vars). Secret: `INGEST_TOKEN` (`wrangler secret put INGEST_TOKEN`).
  // Povratak: `wrangler delete` (miče rutu) + `wrangler d1 delete katalog`.
  "routes": [{ "pattern": "domovina.ai/api/katalog/*", "zone_name": "domovina.ai" }],

  // Brend kad host zahtjeva nije u `brands.host` (npr. `wrangler dev` na
  // localhostu), odluka 305.
  "vars": { "DEFAULT_BRAND": "domovina" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "katalog",
      // Produkcijska baza (S6, hint `eeur`). Nije tajna: bez tokena ne daje
      // pristup. Lokalno (`--local`, vitest) je ID samo ključ lokalne SQLite datoteke.
      "database_id": "a841df13-2474-40d0-b368-63b133fcbf05",
      "migrations_dir": "migrations"
    }
  ],

  // Staging (S5, odluka 409/500): samo workers.dev, bez `routes`, bez secreta.
  // D1 vezanja i `vars` se ne nasljeđuju iz vrha, pa se ponavljaju.
  // `database_id` nije tajna (bez tokena ne daje pristup); `account_id` se
  // NE upisuje, ide kroz `CLOUDFLARE_ACCOUNT_ID` u okolini (vidi .dev.vars).
  // Povratak: `wrangler delete --env staging` + `wrangler d1 delete katalog-staging`.
  "env": {
    "staging": {
      "name": "domovina-katalog-staging",
      "workers_dev": true,
      // Custom domena za aplikaciju (odluka 507): Cloudflare sam napravi DNS zapis
      // i certifikat. Host nije u `brands.host`, pa brend daje DEFAULT_BRAND.
      "routes": [{ "pattern": "katalog-staging.domovina.ai", "custom_domain": true }],
      "vars": { "DEFAULT_BRAND": "domovina" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "katalog-staging",
          "database_id": "80c56ea0-0fa3-4bbc-9b36-31b1c8641bbf",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
