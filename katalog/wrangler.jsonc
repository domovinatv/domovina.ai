{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domovina-katalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "observability": { "enabled": true },

  // Namjerno BEZ `routes` i BEZ `account_id`: u F0 se ništa ne deploya.
  // Ruta (`domovina.ai/api/katalog/v1/*`, isti origin kao aplikacija) dolazi
  // tek sa staging/produkcijskim deployem (S5/S6).

  // Brend kad host zahtjeva nije u `brands.host` (npr. `wrangler dev` na
  // localhostu), odluka 305.
  "vars": { "DEFAULT_BRAND": "domovina" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "katalog",
      // PLACEHOLDER, nije stvarna baza. Stvarni ID se upisuje tek u S5,
      // kad se baza napravi na računu. Lokalno (`--local`, vitest) ID se ne
      // koristi za ništa osim kao ključ lokalne SQLite datoteke.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Staging (S5, odluka 409/500): samo workers.dev, bez `routes`, bez secreta.
  // D1 vezanja i `vars` se ne nasljeđuju iz vrha, pa se ponavljaju.
  // `database_id` nije tajna (bez tokena ne daje pristup); `account_id` se
  // NE upisuje, ide kroz `CLOUDFLARE_ACCOUNT_ID` u okolini (vidi .dev.vars).
  // Povratak: `wrangler delete --env staging` + `wrangler d1 delete katalog-staging`.
  "env": {
    "staging": {
      "name": "domovina-katalog-staging",
      "workers_dev": true,
      // Custom domena za aplikaciju (odluka 507): Cloudflare sam napravi DNS zapis
      // i certifikat. Host nije u `brands.host`, pa brend daje DEFAULT_BRAND.
      "routes": [{ "pattern": "katalog-staging.domovina.ai", "custom_domain": true }],
      "vars": { "DEFAULT_BRAND": "domovina" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "katalog-staging",
          "database_id": "80c56ea0-0fa3-4bbc-9b36-31b1c8641bbf",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
