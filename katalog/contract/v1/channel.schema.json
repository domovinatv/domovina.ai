{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domovina.ai/api/katalog/v1/contract/channel.schema.json",
  "title": "Kanal",
  "description": "Zaglavlje kanala (/channels/:slug) i stavka popisa kanala.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "tier",
    "lang",
    "avatar",
    "youtube_channel_id",
    "processed_count",
    "latest_published_date",
    "unregistered"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        1,
        2
      ]
    },
    "lang": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 16
    },
    "avatar": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "youtube_channel_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "processed_count": {
      "description": "Broj epizoda koje lista /channels/:slug/episodes (bez varijanti), uključujući one bez datuma",
      "type": "integer",
      "minimum": 0
    },
    "latest_published_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unregistered": {
      "description": "Tier 2 kanal bez registry unosa (yt-…, x-…), odluka 205",
      "type": "boolean"
    },
    "settings": {
      "$ref": "channel-settings.schema.json#/$defs/sparse"
    }
  }
}
