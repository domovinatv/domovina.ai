{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domovina.ai/api/katalog/v1/contract/channel-episodes.schema.json",
  "title": "GET /channels/:slug/episodes",
  "description": "Epizode kanala, najnovije prve, bez varijanti. Povučen kanal: state withdrawn, items [] i next null; obrisan: state deleted + deleted_at, items []. 404 samo kad nema ni kanala ni tombstonea.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog",
    "items",
    "next",
    "meta"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "catalog": {
      "description": "ID zadnjeg uspješnog uvoza (ingest_runs), null kad ga nema",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "channel-settings.schema.json#/$defs/state"
    },
    "deleted_at": {
      "$ref": "channel-settings.schema.json#/$defs/deleted_at"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "card.schema.json"
      }
    },
    "next": {
      "description": "Neproziran keyset kursor; null na zadnjoj stranici",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_read"
      ],
      "properties": {
        "rows_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "deleted"
          }
        }
      },
      "then": {
        "required": [
          "deleted_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "deleted_at"
          ]
        }
      }
    }
  ]
}
