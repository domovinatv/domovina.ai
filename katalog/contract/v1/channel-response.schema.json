{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domovina.ai/api/katalog/v1/contract/channel-response.schema.json",
  "title": "GET /channels/:slug",
  "description": "Zaglavlje kanala. Povučen kanal: state withdrawn, item je cijeli kanal; obrisan: state deleted + deleted_at, item je samo identitet (bez avatara, 0 epizoda). 404 samo kad nema ni kanala ni tombstonea.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog",
    "item",
    "meta"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "catalog": {
      "description": "ID zadnjeg uspješnog uvoza (ingest_runs), null kad ga nema",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "channel-settings.schema.json#/$defs/state"
    },
    "deleted_at": {
      "$ref": "channel-settings.schema.json#/$defs/deleted_at"
    },
    "item": {
      "$ref": "channel.schema.json"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_read"
      ],
      "properties": {
        "rows_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "const": "deleted"
          }
        }
      },
      "then": {
        "required": [
          "deleted_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "deleted_at"
          ]
        }
      }
    }
  ]
}
