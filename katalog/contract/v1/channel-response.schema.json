{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domovina.ai/api/katalog/v1/contract/channel-response.schema.json",
  "title": "GET /channels/:slug",
  "description": "Zaglavlje kanala.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "catalog",
    "item",
    "meta"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "catalog": {
      "description": "ID zadnjeg uspješnog uvoza (ingest_runs), null kad ga nema",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "item": {
      "$ref": "channel.schema.json"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows_read"
      ],
      "properties": {
        "rows_read": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
