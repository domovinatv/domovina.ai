---
// Admin urednika: poslužitelj daje samo ljusku i konfiguraciju; podaci idu iz
// preglednika izravno u PostgREST s JWT-om urednika (RLS odlučuje, odluka 607).
import Base from '../../layouts/Base.astro';
import { CACHE_ADMIN } from '../../lib/cache.js';
import { portalConfig } from '../../lib/runtime.js';

const cfg = portalConfig();
Astro.response.headers.set('Cache-Control', CACHE_ADMIN);
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const clientConfig = JSON.stringify({
  restUrl: cfg.restUrl,
  anonKey: cfg.anonKey,
  authUrl: cfg.authUrl,
  cdnBase: cfg.cdnBase,
  appBase: cfg.appBase,
  portalBase: import.meta.env.BASE_URL.replace(/\/+$/, ''),
});
---
<Base title="Uredništvo" noindex nav={false}>
  <script type="application/json" id="vijesti-config" set:html={clientConfig.replace(/</g, '\\u003c')} />
  <div class="admin-head">
    <h1>Uredništvo</h1>
    <div id="admin-user"></div>
  </div>
  <div id="admin-error" class="admin-error" role="alert" data-testid="admin-error" hidden></div>
  <p id="admin-status" class="admin-status" role="status" data-testid="admin-status"></p>
  <div id="admin" data-testid="admin-root"><p class="muted">Učitavam…</p></div>
  <noscript><p class="notice">Uredništvo traži JavaScript.</p></noscript>
</Base>

<script>
  import '../../scripts/admin/main.ts';
</script>

<style is:global>
  .admin-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .muted {
    color: var(--muted);
  }
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
    margin: 1rem 0;
  }
  .panel h2 {
    font-size: 1.25rem;
  }
  .admin-error {
    border: 1px solid var(--danger);
    color: var(--danger);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
  }
  .admin-error p {
    margin: 0;
  }
  .admin-error .detail {
    font-size: 0.8125rem;
    opacity: 0.85;
    margin-top: 0.25rem;
  }
  .admin-status {
    color: var(--ok);
    min-height: 1.5em;
    margin: 0.5rem 0;
  }
  .queue {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .queue li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .s-published,
  .s-corrected,
  .s-approved {
    color: var(--ok);
  }
  .s-rejected,
  .s-retracted {
    color: var(--danger);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0.5rem 0 1rem;
  }
  .actions .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }
  .actions input {
    flex: 1 1 14rem;
  }
  button {
    font: inherit;
    font-size: 0.9375rem;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--fg);
    cursor: pointer;
  }
  button.primary {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  button.danger {
    color: var(--danger);
    border-color: var(--danger);
  }
  button.link {
    background: none;
    border: none;
    color: var(--link);
    padding: 0.1rem 0.3rem;
    text-decoration: underline;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 0.9375rem;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    max-width: 100%;
  }
  .wide {
    display: block;
    width: 100%;
    margin: 0.25rem 0 0.75rem;
  }
  .split {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 60rem) {
    .split {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
    .col-moments {
      position: sticky;
      top: 1rem;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }
  .col-article h1 {
    font-size: 1.75rem;
  }
  .col-article .lead {
    font-weight: 600;
  }
  .col-article blockquote,
  .editor blockquote {
    margin: 1rem 0;
    padding-left: 0.75rem;
    border-left: 4px solid var(--quote-bar);
    font-family: var(--font-head);
  }
  .sentences {
    padding-left: 0;
    list-style: none;
  }
  .sent {
    padding: 0.4rem 0.5rem;
    border-left: 4px solid transparent;
    margin-bottom: 0.25rem;
    font-size: 0.9375rem;
  }
  .sent.pending {
    border-left-color: var(--danger);
    background: var(--notice-bg);
  }
  .sent.resolved {
    border-left-color: var(--ok);
  }
  .resolve {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .resolve input {
    flex: 1 1 12rem;
  }
  .moment-list {
    list-style: none;
    padding: 0;
  }
  .moment-list li {
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 0;
  }
  .moment-list li.quoted {
    background: var(--surface-2);
  }
  .moment-list .meta,
  .moment-list .mq {
    margin: 0 0 0.3rem;
    font-size: 0.875rem;
  }
  .moment-list audio {
    width: 100%;
    height: 2.25rem;
  }
  .editor-blocks {
    padding-left: 1.25rem;
  }
  .editor-blocks .tools {
    display: block;
    margin-bottom: 0.75rem;
  }
  .history li,
  .events li {
    font-size: 0.875rem;
    margin-bottom: 0.3rem;
  }
  .login label {
    display: block;
    margin: 0.5rem 0;
  }
</style>
