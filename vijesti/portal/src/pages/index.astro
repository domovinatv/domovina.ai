---
// Naslovnica: najnoviji članak istaknut, ispod najnovije po kategorijama.
import ArticleCardView from '../components/ArticleCard.astro';
import Base from '../layouts/Base.astro';
import { CACHE_ERROR, CACHE_LIST } from '../lib/cache.js';
import { categoryLabel } from '../lib/categories.js';
import { hrDateTime, zagrebDay } from '../lib/format.js';
import { groupByCategory, latestArticles, type ArticleCard } from '../lib/public-data.js';
import { portalConfig, publicRest } from '../lib/runtime.js';
import { canonicalUrl, SITE_DESCRIPTION } from '../lib/seo.js';
import { articlePath, categoryPath } from '../lib/urls.js';

const base = import.meta.env.BASE_URL;
const cfg = portalConfig();
let list: ArticleCard[] | null = null;
try {
  list = await latestArticles(publicRest(cfg), 30);
  Astro.response.headers.set('Cache-Control', CACHE_LIST);
} catch (e) {
  console.error('[vijesti] naslovnica:', e);
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', CACHE_ERROR);
}
const [top, ...rest] = list ?? [];
const groups = groupByCategory(rest);
---
<Base title="Vijesti" description={SITE_DESCRIPTION} canonical={canonicalUrl(cfg.siteBase, base)} noindex={list === null}>
  {list === null && <p class="notice" data-testid="load-error">Vijesti trenutno nisu dostupne. Pokušaj ponovno za minutu.</p>}
  {list !== null && list.length === 0 && <p class="empty" data-testid="empty">Još nema objavljenih vijesti.</p>}
  {
    top && (
      <section class="lead-story" data-testid="lead-story" data-slug={top.slug}>
        {top.category && (
          <p class="kicker">
            <a href={categoryPath(base, top.category)}>{categoryLabel(top.category)}</a>
          </p>
        )}
        <h2>
          <a href={articlePath(base, top.slug)}>{top.title}</a>
        </h2>
        <p class="lead">{top.lead}</p>
        <p class="meta">
          {top.publishedAt && <time datetime={zagrebDay(top.publishedAt)}>{hrDateTime(top.publishedAt)}</time>}
          {top.channelName && <span> · {top.channelName}</span>}
        </p>
      </section>
    )
  }
  {
    groups.map((g) => (
      <section data-testid="category-section" data-category={g.category}>
        <h2 class="section-title">
          <a href={categoryPath(base, g.category)}>{categoryLabel(g.category)}</a>
        </h2>
        <ul class="cards">
          {g.articles.map((c) => (
            <ArticleCardView card={c} showCategory={false} />
          ))}
        </ul>
      </section>
    ))
  }
</Base>
