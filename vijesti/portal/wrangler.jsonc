// Worker portala vijesti. Produkcijske vrijednosti (anon ključ, URL-ovi) upisuje
// S7; zadane su u src/lib/config.ts. `env.local` koristi `npm run portal:dev`
// (CLOUDFLARE_ENV=local): PostgREST-shim i lažni CDN na 127.0.0.1:8790.
{
  "name": "domovina-vijesti",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Odluka 740: zonska ruta ima prednost pred Pages projektom domovina-ai.
  "routes": [{ "pattern": "domovina.ai/vijesti*", "zone_name": "domovina.ai" }],
  // Produkcija (odluka 710). Prazno = „[upisuje izdavač]” u impresumu, a
  // `npm run portal:release-check` (i build uz VIJESTI_RELEASE=1) pada dok je
  // ijedno prazno. Anon ključ je javan (Supabase `apikey`), nije tajna.
  "vars": {
    "VIJESTI_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc3OTExMTcxMywiZXhwIjo0OTMyNzExNzEzLCJyb2xlIjoiYW5vbiJ9.Q4Ef7xMc2dmjMyfJebPDyqNirnARZzMxTWe7i0dASPI",
    "VIJESTI_PUBLISHER_NAME": "",
    "VIJESTI_PUBLISHER_ADDRESS": "",
    "VIJESTI_EDITOR_IN_CHIEF": "",
    "VIJESTI_CONTACT_EMAIL": "",
    "VIJESTI_AEM_REGISTRATION": "",
    // Odluka 801: tehnička produkcija prije impresuma i AEM-a. Ukloni kad
    // `portal:release-check` prođe.
    "VIJESTI_NOINDEX": "1"
  },
  "env": {
    "local": {
      "vars": {
        "VIJESTI_REST_URL": "http://127.0.0.1:8790",
        "VIJESTI_AUTH_URL": "http://127.0.0.1:8790",
        "VIJESTI_ANON_KEY": "lokalni-anon-kljuc",
        "VIJESTI_CDN_BASE": "http://127.0.0.1:8790/cdn",
        "VIJESTI_APP_BASE": "https://domovina.ai"
      }
    }
  }
}
