{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "dev/**/*", "test/**/*", "e2e/**/*", "playwright.config.ts", "astro.config.mjs"],
  "exclude": ["dist", "dist-local"]
}
