# Kopiraj u vijesti/.env (gitignored) i upiši vrijednosti. Nikad ne commitaj .env.
# Testovi ništa odavde ne koriste.

# Backend: vertex | studio | agy. Zadano vertex ako GEMINI_API_KEY nije postavljen
# (odluka 300). Pravi pozivi idu kroz agy (odluka 315): Gemini u Antigravity CLI-ju
# u tmuxu, na Google AI Pro pretplati ($0), serijski, ~60 s po pozivu.
VIJESTI_LLM_BACKEND=

# agy (odluke 400–404). Sesija je vlastita (pipeline koristi agyen/agyss/agyt);
# gledanje: tmux attach -t =agyvij -r. Direktorij mora biti „trusted” za agy
# (prvo pitanje se potvrđuje samo); zadano ~/git/.agy-tmux/<sesija>, kao pipeline.
# Model unutar agyja (zadano gemini-3.8-flash-high, kao pipeline) i timeout po
# pozivu (zadano 600 s; odbijen upit izgleda kao timeout).
VIJESTI_AGY_SESSION=
VIJESTI_AGY_MODEL=
VIJESTI_AGY_DIR=
VIJESTI_AGY_TIMEOUT_SEC=

# Mjerenje F0 (ODGOĐENO, korisnik kaže kad; vijesti/TODO.md). Iz vijesti/:
#   1. procjena bez poziva:
#      VIJESTI_LLM_BACKEND=agy npm run eval -- --channels mreze_rijeci,iva_kraljevic,catholic_futurist,domovina_tv --limit 5 --dry-run
#   2. pravi prolaz (run_in_background, bez praćenja napretka; ponovno pokretanje nastavlja):
#      VIJESTI_LLM_BACKEND=agy npm run eval -- --channels mreze_rijeci,iva_kraljevic,catholic_futurist,domovina_tv --limit 5 --max-calls 500
#   3. izvještaj:
#      npm run eval:report -- --out docs/research/YYYY-MM-DD-f0-mjerenje.md
# Baza je .cache/eval.pglite, log .cache/eval.pglite.log (jedan redak po epizodi).

# Vertex AI (OAuth token iz `gcloud auth print-access-token --account=…`, keš 50 min).
# Projekt i account: isti kao pipeline (fetch.domovina.tv/gemini.conf). Account pinaj
# izričito: aktivni gcloud account zna biti drugi service account (403).
VIJESTI_VERTEX_PROJECT=
VIJESTI_VERTEX_ACCOUNT=
# global (zadano) | eu | us | regija. 3.x flash je global-only; eu/us su +10 % cijene.
VIJESTI_VERTEX_LOCATION=

# AI Studio ključ (samo backend studio).
GEMINI_API_KEY=

# Model (zadano: gemini-3.8-flash, kao pipeline od 15.9.2026.).
VIJESTI_GEMINI_MODEL=

# Polje sheme izlaza: responseJsonSchema (zadano) | responseSchema (OpenAPI podskup).
# Ako prvi pravi poziv vrati 400 na responseJsonSchema, prebaci ovdje (odluka 303).
VIJESTI_GEMINI_SCHEMA_FIELD=

# Cijena u USD po milijun tokena; pobjeđuje zadani cjenik. Bez njih vertex +
# gemini-3.8-flash ima zadanu cijenu u kodu (0,75 / 3,75 global do 31.12.2026.,
# od 1.1.2027. 1,50 / 7,50; odluka 304), a studio je nepoznat (trošak NULL).
VIJESTI_GEMINI_PRICE_IN_PER_MTOK=
VIJESTI_GEMINI_PRICE_OUT_PER_MTOK=

# CDN (zadano https://cdn.domovina.ai) i disk cache (zadano vijesti/.cache/cdn).
VIJESTI_CDN_BASE=
VIJESTI_CACHE_DIR=

# Dnevni job (S8, odluke 808–809): scripts/daily.sh + launchd/ai.domovina.vijesti-daily.plist.
# Engine piše u produkcijsku bazu kao uloga `vijesti_engine` (migracija 007) kroz
# SSH tunel do kontejnera baze na Coolify hostu; Postgres nije javno izložen.
# SSH cilj (user@host) i ključ Coolify hosta Supabase stacka:
VIJESTI_SSH_TARGET=
VIJESTI_SSH_KEY=
# Lozinka uloge vijesti_engine (postavlja je produkcijski paket, db/prod/README.md):
VIJESTI_ENGINE_DB_PASSWORD=
# Lokalni port tunela (zadano 54329).
VIJESTI_TUNNEL_PORT=
# Dnevni limit poziva modela (zadano 150); od njega se oduzima sve potrošeno od
# ponoći po Zagrebu, i ručna pokretanja.
VIJESTI_DAILY_MAX_CALLS=
# Backend za dnevni job: claude (odluka 802), npr. VIJESTI_LLM_BACKEND=claude gore.
