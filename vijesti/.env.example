# Kopiraj u vijesti/.env (gitignored) i upiši vrijednosti. Nikad ne commitaj .env.
# Testovi ništa odavde ne koriste.

# Backend: vertex | studio. Zadano vertex ako GEMINI_API_KEY nije postavljen (odluka 300).
VIJESTI_LLM_BACKEND=

# Vertex AI (OAuth token iz `gcloud auth print-access-token --account=…`, keš 50 min).
# Projekt i account: isti kao pipeline (fetch.domovina.tv/gemini.conf). Account pinaj
# izričito: aktivni gcloud account zna biti drugi service account (403).
VIJESTI_VERTEX_PROJECT=
VIJESTI_VERTEX_ACCOUNT=
# global (zadano) | eu | us | regija. 3.x flash je global-only; eu/us su +10 % cijene.
VIJESTI_VERTEX_LOCATION=

# AI Studio ključ (samo backend studio).
GEMINI_API_KEY=

# Model (zadano: gemini-3.8-flash, kao pipeline od 15.9.2026.).
VIJESTI_GEMINI_MODEL=

# Polje sheme izlaza: responseJsonSchema (zadano) | responseSchema (OpenAPI podskup).
# Ako prvi pravi poziv vrati 400 na responseJsonSchema, prebaci ovdje (odluka 303).
VIJESTI_GEMINI_SCHEMA_FIELD=

# Cijena u USD po milijun tokena; pobjeđuje zadani cjenik. Bez njih vertex +
# gemini-3.8-flash ima zadanu cijenu u kodu (0,75 / 3,75 global do 31.12.2026.,
# od 1.1.2027. 1,50 / 7,50; odluka 304), a studio je nepoznat (trošak NULL).
VIJESTI_GEMINI_PRICE_IN_PER_MTOK=
VIJESTI_GEMINI_PRICE_OUT_PER_MTOK=

# CDN (zadano https://cdn.domovina.ai) i disk cache (zadano vijesti/.cache/cdn).
VIJESTI_CDN_BASE=
VIJESTI_CACHE_DIR=
