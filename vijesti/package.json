{
  "name": "domovina-vijesti",
  "version": "0.1.0",
  "private": true,
  "description": "Portal vijesti iz podcasta (engine, baza, portal) za domovina.ai/vijesti",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run portal:check && npm run portal:build && npm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fixtures:refresh": "tsx engine/test/fixtures-refresh.ts",
    "cdn:stats": "tsx engine/cdn/stats-cli.ts",
    "verify:measure": "tsx engine/verify/measure-cli.ts",
    "vijesti": "tsx engine/cli.ts",
    "eval": "tsx engine/eval/cli.ts",
    "db:bundle": "tsx db/bundle.ts",
    "eval:report": "tsx engine/eval/cli.ts report",
    "eval:drafts": "tsx engine/eval/cli.ts drafts",
    "portal:dev": "tsx portal/dev/dev.ts",
    "portal:shim": "tsx portal/dev/serve-shim.ts",
    "portal:build": "astro build --root portal",
    "portal:check": "astro check --root portal",
    "portal:preview": "tsx portal/dev/preview.ts",
    "portal:release-check": "tsx portal/dev/release-check.ts",
    "e2e": "playwright test -c portal/playwright.config.ts",
    "lighthouse": "tsx portal/dev/lighthouse.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "daily": "tsx engine/daily/cli.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@electric-sql/pglite": "^0.5.15",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^7.4.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
